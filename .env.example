# Skopiuj do .env (lokalnie) albo ustaw w Vercel → Project → Settings → Environment Variables.
# Nie commituj prawdziwych kluczy – .env jest w .gitignore.

# Baza Postgres (np. Neon z Vercel Marketplace; lokalnie: postgres://user:haslo@localhost:5432/amigos)
DATABASE_URL=

# Płatności: mock (symulacja, bez kluczy) | real (Stripe)
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publiczny adres strony – do linków powrotu z płatności, np. https://amigoscar.pl (lokalnie ustawia się sam)
PUBLIC_BASE_URL=

# Konto admina zakładane przez `npm run seed` (bez ADMIN_PASSWORD hasło zostanie wylosowane i wypisane)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Sekret dla Vercel Cron (sprzątanie wygasłych holdów, /api/cron) – dowolny długi losowy ciąg
CRON_SECRET=

# Opcjonalnie
# HOLD_MINUTES=15            # ile minut termin czeka na zaliczkę (Stripe wymusza minimum 30)
# BOOKING_LEAD_MINUTES=60    # najwcześniej ile minut od teraz można zarezerwować termin

# Dotychczasowe, opcjonalne powiadomienie e-mail / webhook o zgłoszeniu (bez zmian)
# RESEND_API_KEY=
# BOOKING_TO=
# BOOKING_FROM=
# WEBHOOK_URL=
# WEBHOOK_SECRET=
